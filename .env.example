PORT=3000
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=2h

# Postgres en Supabase: cadena del "Session pooler" (puerto 5432), sin ?sslmode
# (db.js ya activa SSL). Caracteres especiales de la contraseña, codificados
# para URL (@ → %40, # → %23, / → %2F, : → %3A).
DATABASE_URL=postgresql://postgres.REF_DEL_PROYECTO:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:5432/postgres
# Opcional: conexiones máximas del pool (por defecto 10)
# PG_POOL_MAX=10

# URL pública usada para generar el QR de cada mesa (US-10). En Render, la URL
# real del servicio (ej. https://licoreria.onrender.com); en local puede omitirse.
BASE_URL=http://localhost:3000

# Solo usados por "npm run seed" para crear el primer administrador, y solo si
# la base no tiene ninguno. Usa una contraseña propia, no la de ejemplo.
ADMIN_NOMBRE=Administrador
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CambiarEsta123

# Datos del negocio para la factura (solo los usa "npm run seed" la primera vez;
# después se editan con PUT /api/emisor)
EMISOR_RAZON_SOCIAL=
EMISOR_NIT=
EMISOR_DIRECCION=
EMISOR_TELEFONO=
EMISOR_REGIMEN=Régimen Simple de Tributación - SIMPLE
